            "index": 0
          }
        ]
      ]
    },
    "FFprobe + Silêncios": {
      "main": [
        [
          {
            "node": "Montar Clipes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar Clipes": {
      "main": [
        [
          {
            "node": "Extrair Áudio do Clipe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extrair Áudio do Clipe": {
      "main": [
        [
          {
            "node": "Preparar Whisper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Whisper": {
      "main": [
        [
          {
            "node": "Whisper.cpp Transcrever",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Whisper.cpp Transcrever": {
      "main": [
        [
          {
            "node": "Preparar Corte Final",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Corte Final": {
      "main": [
        [
          {
            "node": "FFmpeg Cortar 9:16 + Legenda",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FFmpeg Cortar 9:16 + Legenda": {
      "main": [
        [
          {
            "node": "Preparar Leitura",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Leitura": {
      "main": [
        [
          {
            "node": "Ler Short do Disco",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ler Short do Disco": {
      "main": [
        [
          {
            "node": "Upload → Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "version": "v16",
    "gdriveFolder": "1wW1WhX1oyb4jbP0vQded403fQdmDMQQl"
  }
}
