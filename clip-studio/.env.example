# Copy to .env for local dev, or to the deployment stack's .env (see
# openspec/changes/add-clip-studio-app/design.md - Migration Plan / task 8.3).
# Never commit the real .env - it's already in .gitignore.

DATABASE_URL="postgresql://user:password@localhost:5432/clipstudio?schema=public"

# NextAuth/Auth.js session secret - generate with `openssl rand -base64 32`.
AUTH_SECRET=""

# Bootstrap-only fallback for lib/config.ts (getAppConfig) before an Admin
# saves anything through Configurações - normally set there instead.
N8N_WEBHOOK_BASE_URL=""
N8N_WEBHOOK_SHARED_SECRET=""

# Used once by `npm run db:seed` to create the initial Admin account -
# never hardcode a default password (see prisma/seed.ts).
SEED_ADMIN_EMAIL="admin@studio.com"
SEED_ADMIN_PASSWORD=""
