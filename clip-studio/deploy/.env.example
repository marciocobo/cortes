# Stack-level secrets for docker-compose.yml. Copy to `.env` in this same
# directory on the VPS (never commit the real file - matches the
# `.env`/`stack.env` pattern already used by the other apps, see VPS.md §12).

POSTGRES_USER=clipstudio
POSTGRES_PASSWORD=
POSTGRES_DB=clipstudio

# Generate with: openssl rand -base64 32
AUTH_SECRET=

NEXTAUTH_URL=https://clipstudio.mcobo.com.br
