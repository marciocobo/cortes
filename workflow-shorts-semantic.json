{
  "name": "YouTube Shorts Generator — Semântico (Claude + Whisper.cpp local, zero API de transcrição)",
  "nodes": [
    {
      "id": "n1",
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        160,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "1wW1WhX1oyb4jbP0vQded403fQdmDMQQl",
          "mode": "id"
        },
        "event": "fileCreated"
      }
    },
    {
      "id": "n2",
      "name": "Baixar Vídeo",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        340,
        300
      ],
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        }
      }
    },
    {
      "id": "n3",
      "name": "Salvar na VPS",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        520,
        300
      ],
      "parameters": {
        "fileName": "=/home/node/.n8n-files/{{ $('Google Drive Trigger').first().json.name }}",
        "dataPropertyName": "data"
      }
    },
    {
      "id": "n4",
      "name": "Preparar Caminhos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "jsCode": "const t = $('Google Drive Trigger').first().json;\nconst base = '/home/node/.n8n-files/';\nreturn [{ json: {\n  videoName: t.name,\n  videoPath: base + t.name,\n  audioPath: base + 'audio_full.wav'\n}}];\n"
      }
    },
    {
      "id": "n5",
      "name": "FFprobe + Extrair Áudio",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        880,
        300
      ],
      "parameters": {
        "command": "=DUR=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 \"{{ $json.videoPath }}\") && echo \"DURATION:$DUR\" && ffmpeg -y -i \"{{ $json.videoPath }}\" -vn -acodec pcm_s16le -ar 16000 -ac 1 \"{{ $json.audioPath }}\""
      }
    },
    {
      "id": "n6",
      "name": "Preparar Whisper Completo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        300
      ],
      "parameters": {
        "jsCode": "const c = $('Preparar Caminhos').first().json;\nconst out = $json.stdout || '';\nconst m = out.match(/DURATION:([\\d.]+)/);\nconst duration = m ? parseFloat(m[1]) : 0;\nconst srtBase = '/home/node/.n8n-files/transcript_full';\nreturn [{ json: { ...c, duration, srtBase, srtPath: srtBase + '.srt' } }];\n"
      }
    },
    {
      "id": "n7",
      "name": "Whisper.cpp Transcrever Completo",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1240,
        300
      ],
      "parameters": {
        "command": "=whisper -m /models/ggml-base.bin -f \"{{ $json.audioPath }}\" -l pt -osrt -of \"{{ $json.srtBase }}\" -np && cat \"{{ $json.srtPath }}\""
      }
    },
    {
      "id": "n8",
      "name": "Preparar Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        300
      ],
      "parameters": {
        "jsCode": "const c = $('Preparar Whisper Completo').first().json;\nconst transcript = $json.stdout || '';\nreturn [{ json: { ...c, transcript } }];\n"
      }
    },
    {
      "id": "n9",
      "name": "Claude — Gerar Clipes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1600,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_ANTHROPIC_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 3000, system: 'Você é um editor sênior de YouTube Shorts. Analise a transcrição em formato SRT (com timestamps) e identifique até 5 dos MELHORES momentos para Shorts de 75s a 150s. Cada clipe deve ser AUTOCONTIDO, ter GANCHO nos 3 primeiros segundos, CONCLUSÃO clara, coesão semântica, e os cortes devem cair em pausas de fala. Use os timestamps do SRT (convertidos para segundos) para start/end. Retorne APENAS JSON sem markdown, no máximo 5 itens, ordenados do melhor para o pior: [{\\\"start\\\":0,\\\"end\\\":90,\\\"title\\\":\\\"slug-curto\\\",\\\"hook\\\":\\\"Frase de abertura\\\",\\\"reason\\\":\\\"Motivo da escolha\\\"}]', messages: [{ role: 'user', content: 'Duração total: ' + $json.duration + 's\\n\\nTranscrição (SRT):\\n' + $json.transcript }] }) }}"
      }
    },
    {
      "id": "n10",
      "name": "Montar Clipes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ],
      "parameters": {
        "jsCode": "const raw = $json.content[0].text.trim()\n  .replace(/```json|```/g, '')\n  .replace(/^[^[]*/, '');\nconst clips = JSON.parse(raw).slice(0, 5);\nconst c = $('Preparar Claude').first().json;\nconst vp = c.videoPath;\nconst vn = c.videoName;\nconst MIN_DUR = 75, MAX_DUR = 150;\nconst base = '/home/node/.n8n-files/';\nconst results = [];\nfor (let i = 0; i < clips.length; i++) {\n  const clip = clips[i];\n  const dur = clip.end - clip.start;\n  if (dur < MIN_DUR - 10 || dur > MAX_DUR + 15) continue;\n  const idx = String(results.length + 1).padStart(2, '0');\n  const slug = (clip.title || 'clip').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40);\n  const outPath   = base + 'short_' + idx + '_' + slug + '.mp4';\n  const audioPath = base + 'clip_' + idx + '.wav';\n  const srtBase   = base + 'clip_' + idx;\n  const srtPath   = srtBase + '.srt';\n  const metaPath  = base + 'clip_' + idx + '_meta.json';\n  const ds = Math.round(dur);\n  const metaContent = JSON.stringify({\n    index: results.length + 1,\n    title: clip.title,\n    slug,\n    hook: clip.hook || '',\n    reason: clip.reason || '',\n    start: clip.start,\n    end: clip.end,\n    duration: Math.floor(ds / 60) + 'm' + (ds % 60) + 's',\n    videoSource: vn\n  }, null, 2);\n  results.push({\n    clipStart: Math.max(0, clip.start),\n    clipEnd: clip.end,\n    idx,\n    titleSlug: slug,\n    hook: clip.hook || '',\n    reason: clip.reason || '',\n    videoPath: vp,\n    videoName: vn,\n    outPath,\n    audioPath,\n    srtBase,\n    srtPath,\n    metaPath,\n    metaContent\n  });\n}\nreturn results;\n"
      }
    },
    {
      "id": "n10a",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1960,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "n10b",
      "name": "Extrair Áudio do Clipe",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2180,
        440
      ],
      "parameters": {
        "command": "=ffmpeg -y -ss \"{{ $json.clipStart }}\" -to \"{{ $json.clipEnd }}\" -i \"{{ $json.videoPath }}\" -vn -acodec pcm_s16le -ar 16000 -ac 1 \"{{ $json.audioPath }}\""
      }
    },
    {
      "id": "n10c",
      "name": "Preparar Whisper",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2360,
        440
      ],
      "parameters": {
        "jsCode": "const c = $('Loop Over Items').item.json;\nreturn [{ json: c }];\n"
      }
    },
    {
      "id": "n10d",
      "name": "Whisper.cpp Transcrever",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2540,
        440
      ],
      "parameters": {
        "command": "=whisper -m /models/ggml-base.bin -f \"{{ $json.audioPath }}\" -l pt -osrt -of \"{{ $json.srtBase }}\" -np"
      }
    },
    {
      "id": "n10e",
      "name": "Preparar Corte Final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        440
      ],
      "parameters": {
        "jsCode": "const c = $('Loop Over Items').item.json;\nreturn [{ json: c }];\n"
      }
    },
    {
      "id": "n11",
      "name": "FFmpeg Cortar 9:16 + Legenda",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2900,
        440
      ],
      "parameters": {
        "command": "=printf '%s' '{{ $json.metaContent }}' > \"{{ $json.metaPath }}\" && ffmpeg -y -ss \"{{ $json.clipStart }}\" -to \"{{ $json.clipEnd }}\" -i \"{{ $json.videoPath }}\" -vf \"scale=-2:1920,crop=1080:1920:(iw-1080)/2:(ih-1920)/2,subtitles={{ $json.srtPath }}:force_style='FontSize=14,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BorderStyle=3,Alignment=2,MarginV=18'\" -c:v libx264 -preset fast -crf 22 -c:a aac -b:a 128k -movflags +faststart \"{{ $json.outPath }}\""
      }
    },
    {
      "id": "n12",
      "name": "Preparar Leitura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        440
      ],
      "parameters": {
        "jsCode": "const clip = $('Loop Over Items').item.json;\nreturn [{ json: {\n  outPath:   clip.outPath,\n  metaPath:  clip.metaPath,\n  idx:       clip.idx,\n  titleSlug: clip.titleSlug,\n  videoName: clip.videoName\n}}];\n"
      }
    },
    {
      "id": "n13",
      "name": "Ler Short do Disco",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        3260,
        440
      ],
      "parameters": {
        "filePath": "={{ $json.outPath }}",
        "dataPropertyName": "data"
      }
    },
    {
      "id": "n14",
      "name": "Upload Short → Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3440,
        440
      ],
      "parameters": {
        "operation": "upload",
        "name": "={{ 'short_' + $('Preparar Leitura').item.json.idx + '_' + $('Preparar Leitura').item.json.titleSlug + '.mp4' }}",
        "parents": [
          "1wW1WhX1oyb4jbP0vQded403fQdmDMQQl"
        ],
        "inputDataFieldName": "data"
      }
    },
    {
      "id": "n15",
      "name": "Preparar Leitura Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3620,
        440
      ],
      "parameters": {
        "jsCode": "const clip = $('Loop Over Items').item.json;\nreturn [{ json: {\n  metaPath:  clip.metaPath,\n  idx:       clip.idx,\n  titleSlug: clip.titleSlug,\n  videoName: clip.videoName\n}}];\n"
      }
    },
    {
      "id": "n16",
      "name": "Ler Metadados do Disco",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        3800,
        440
      ],
      "parameters": {
        "filePath": "={{ $json.metaPath }}",
        "dataPropertyName": "data"
      }
    },
    {
      "id": "n17",
      "name": "Upload Metadados → Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3980,
        440
      ],
      "parameters": {
        "operation": "upload",
        "name": "={{ 'short_' + $('Preparar Leitura Meta').item.json.idx + '_' + $('Preparar Leitura Meta').item.json.titleSlug + '_meta.json' }}",
        "parents": [
          "1wW1WhX1oyb4jbP0vQded403fQdmDMQQl"
        ],
        "inputDataFieldName": "data"
      }
    }
  ],
